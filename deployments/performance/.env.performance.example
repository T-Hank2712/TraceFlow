# Production-like performance environment

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL
POSTGRES_DB=traceflow
POSTGRES_USER=traceflow
POSTGRES_PASSWORD=change-me

# Kafka
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

KAFKA_HEAP_OPTS=-Xms768m -Xmx768m

# OpenSearch
OPENSEARCH_CLUSTER_NAME=traceflow-performance
OPENSEARCH_NODE_NAME=traceflow-performance-node
OPENSEARCH_DISCOVERY_TYPE=single-node
OPENSEARCH_BOOTSTRAP_MEMORY_LOCK=true
OPENSEARCH_JAVA_OPTS=-Xms1280m -Xmx1280m
OPENSEARCH_DISABLE_SECURITY_PLUGIN=false
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=96mb

# Control API
Jwt__Issuer=TraceFlow
Jwt__Audience=TraceFlow
Jwt__Secret=change-me
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30

ApiKeySecurity__Pepper=change-me
InternalService__Secret=change-me
RefreshTokenSecurity__Pepper=change-me-refresh-token-pepper-at-least-32-bytes

OpenSearch__Url=https://opensearch:9200
OpenSearch__Username=admin
OpenSearch__Password=change-me
OpenSearch__Index=traceflow-logs
OpenSearch__SkipTlsVerify=false

RateLimit__Global__PermitLimit=100
RateLimit__Global__WindowSeconds=60
RateLimit__Global__QueueLimit=20

RateLimit__Auth__PermitLimit=10
RateLimit__Auth__WindowSeconds=60
RateLimit__Auth__QueueLimit=0

RateLimit__Internal__PermitLimit=1000
RateLimit__Internal__WindowSeconds=60
RateLimit__Internal__QueueLimit=100

RateLimit__Search__PermitLimit=60
RateLimit__Search__WindowSeconds=60
RateLimit__Search__QueueLimit=10

TrustedProxies__KnownNetworks__0=172.20.0.0/16

RequestBodyLimits__DefaultBytes=1048576
RequestBodyLimits__AuthBytes=32768
RequestBodyLimits__InternalBytes=16384
RequestBodyLimits__SearchBytes=1048576

Database__MaxRetryCount=3
Database__MaxRetryDelaySeconds=5

# Ingestion
ControlApi__BaseUrl=http://control-api:5075
ControlApi__ValidateApiPath=/internal/v1/api-keys/validate
ControlApi__InternalServiceSecret=change-me
ControlApi__TimeoutSeconds=5

Kafka__BootstrapServers=kafka:9092
Kafka__Topic=traceflow.logs
Kafka__MessageSendMaxRetries=5
Kafka__RetryBackoffMs=500
Kafka__MessageTimeoutMs=10000
Kafka__DeliveryTimeoutMs=5
Kafka__QueueBufferingMaxMessages=100000
Kafka__QueueBufferingMaxKbytes=1048576
Kafka__LingerMs=5

Ingestion__MaxBatchSize=100
Ingestion__MaxRequestBodyBytes=1048576
Ingestion__MaxMessageLength=8192
Ingestion__MaxServiceLength=128
Ingestion__MaxTraceIdLength=128
Ingestion__MaxCorrelationIdLength=128
Ingestion__MaxMetadataKeys=50
Ingestion__MaxMetadataDepth=5
Ingestion__MaxMetadataKeyLength=128
Ingestion__MaxMetadataStringValueLength=2048
Ingestion__MaxMetadataArrayLength=50
Ingestion__MaxPastTimestampDays=7
Ingestion__MaxFutureTimestampMinutes=5

Redis__SectionName=Redis
Redis__ConnectionString=redis:6379,password=traceflow_redis_dev_password
Redis__TenantContextCacheTtlSeconds=120
Redis__TenantContextCacheKeyPrefix=traceflow:apikey
Redis__TenantContextMemoryCacheTtlSeconds=30
Redis__TenantContextMemoryCacheKeyPrefix=traceflow:apikey:l1

RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
RateLimiting__RateLimitKeyPrefix=traceflow:ratelimit

PreAuthRateLimiting__PermitLimit=30
PreAuthRateLimiting__WindowSeconds=60
PreAuthRateLimiting__QueueLimit=0

# Processor
Kafka__GroupId=traceflow-log-processor-performance
Kafka__DlqTopic=traceflow.logs.dlq
Kafka__PollTimeoutMs=100

Processor__MaxRetries=3
Processor__RetryBackoffMs=500
Processor__BatchSize=100
Processor__FlushIntervalMs=1000