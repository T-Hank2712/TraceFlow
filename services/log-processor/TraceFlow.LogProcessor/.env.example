Kafka__BootstrapServers=kafka:9092
Kafka__GroupId=traceflow-log-processor
Kafka__DlqTopic=traceflow.logs.dlq
Kafka__Topic=traceflow.logs
Kafka__PollTimeoutMs=100
Kafka__ProducerFlushTimeoutSeconds=5
Kafka__DlqPublishConcurrency=10
Kafka__QueuedMinMessages=10000
Kafka__QueuedMaxMessagesKbytes=65536
Kafka__FetchMinBytes=1
Kafka__FetchWaitMaxMs=50
Kafka__MaxPartitionFetchBytes=1048576

Processor__MaxRetries=3
Processor__RetryBackoffMs=500
Processor__BatchSize=100
Processor__FlushIntervalMs=1000
Processor__QueueCapacity=10000
Processor__ShutdownFlushTimeoutSeconds=10

OpenSearch__Url=https://opensearch:9200
OpenSearch__Username=admin
OpenSearch__Password=change_me
OpenSearch__Index=traceflow-logs
OpenSearch__SkipTlsVerify=true