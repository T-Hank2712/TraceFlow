{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "",
    "TenantContextRedisCacheTtlSeconds": 120,
    "TenantContextRedisCacheKeyPrefix": "traceflow:apikey",
    "TenantContextLocalCacheTtlSeconds": 30,
    "TenantContextLocalCacheKeyPrefix": "traceflow:apikey:l1",
    "ApiKeyRevocationKeyPrefix": "traceflow:apikey:revoked",
    "IdempotencyKeyTtlSeconds": 86400,
    "IdempotencyKeyMaxLength": 128,
    "IdempotencyKeyPrefix": "traceflow:idempotency"
  },
  "TrustedProxies": {
    "KnownNetworks": []
  }
}
