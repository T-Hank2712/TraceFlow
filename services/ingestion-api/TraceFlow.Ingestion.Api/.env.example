ControlApi__BaseUrl=http://control-api:5075
ControlApi__ValidateApiPath=/internal/v1/api-keys/validate
ControlApi__InternalServiceSecret=replace-with-secret
ControlApi__TimeoutSeconds=5

Kafka__BootstrapServers=kafka:9092
Kafka__Topic=traceflow.logs
Kafka__MessageSendMaxRetries=3
Kafka__RetryBackoffMs=500
Kafka__DeliveryTimeoutMs=10000
Kafka__MessageTimeoutMs=10000
Kafka__QueueBufferingMaxMessages=100000
Kafka__QueueBufferingMaxKbytes=1048576
Kafka__LingerMs=5

Ingestion__MaxBatchSize=100
Ingestion__MaxRequestBodyBytes=1048576
Ingestion__MaxMessageLength=8192
Ingestion__MaxServiceLength=128

Redis__SectionName=Redis
Redis__ConnectionString=redis:6379,password=traceflow_redis_dev_password
Redis__TenantContextCacheTtlSeconds=3600
Redis__TenantContextCacheKeyPrefix=traceflow:apikey

RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
RateLimiting__RateLimitKeyPrefix=traceflow:ratelimit

PreAuthRateLimiting__PermitLimit=30
PreAuthRateLimiting__WindowSeconds=60
PreAuthRateLimiting__QueueLimit=0