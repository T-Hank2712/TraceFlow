# =========================================================
# TraceFlow - Docker Infrastructure Environment
# Copy this file to .env and update values as needed.
# =========================================================

# ------------------- Control API -------------------

# ---------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------
Jwt__Issuer=TraceFlow
Jwt__Audience=TraceFlow
Jwt__Secret=change_me_use_a_very_long_random_secret
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30

# ---------------------------------------------------------
# Postgres
# ---------------------------------------------------------
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=traceflow;Username=traceflow;Password=YourStrongAdminPassword123!

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------
API_KEY_PEPPER=replace-with-long-random-server-side-secret-32bytes
INTERNAL_SERVICE_SECRET=replace-with-long-random-internal-secret

# ---------------------------------------------------------
# OpenSearch__Url
# ---------------------------------------------------------
OpenSearch__Url=https://opensearch:9200
OpenSearch__Username=admin
OpenSearch__Password=YourStrongAdminPassword123!
OpenSearch__Index=traceflow-logs
OpenSearch__SkipTlsVerify=true

# ------------------- Ingestion API -------------------

PORT=:8080

MAX_BATCH_SIZE=100
MAX_REQUEST_BODY_BYTES=1048576
CONTROL_API_TIMEOUT_SECONDS=5
KAFKA_DELIVERY_TIMEOUT_SECONDS=5

CONTROL_API_BASE_URL=http://control-api:5075
VALIDATE_API_URL=/internal/api-keys/validate

# ------------------- Log Processor -------------------

KAFKA_CONSUMER_GROUP=traceflow-log-processor
KAFKA_DLQ_TOPIC=traceflow.logs.dlq
KAFKA_POLL_TIMEOUT_MS=100

PROCESSOR_MAX_RETRIES=3
PROCESSOR_RETRY_BACKOFF_MS=500
PROCESSOR_BATCH_SIZE=100
PROCESSOR_FLUSH_INTERVAL_MS=1000

OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=YourStrongAdminPassword123!
OPENSEARCH_INDEX=traceflow-logs
OPENSEARCH_SKIP_TLS_VERIFY=true

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_DB=traceflow
POSTGRES_USER=traceflow
POSTGRES_PASSWORD=YourStrongAdminPassword123!

# ---------------------------------------------------------
# Kafka
# ---------------------------------------------------------

KAFKA_PORT=9092
KAFKA_NODE_ID=1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=traceflow.logs
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# ---------------------------------------------------------
# OpenSearch
# ---------------------------------------------------------

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_CLUSTER_NAME=traceflow-cluster
OPENSEARCH_INITIAL_ADMIN_PASSWORD=YourStrongAdminPassword123!
OPENSEARCH_NODE_NAME=traceflow-node-1
OPENSEARCH_BOOTSTRAP_MEMORY_LOCK=true

OPENSEARCH_URL=https://opensearch:9200

# Single-node development environment
OPENSEARCH_DISCOVERY_TYPE=single-node

# Java heap for local development
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Disable security only for local development
OPENSEARCH_DISABLE_SECURITY_PLUGIN=false
OPENSEARCH_SKIP_TLS_VERIFY=true